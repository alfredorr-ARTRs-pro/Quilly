{
  "name": "quilly",
  "private": true,
  "version": "1.8.0",
  "description": "Voice to Text Desktop App - Talk more, type less",
  "author": "Alfredo Rapetta (A.I.P.S. — https://aips.studio)",
  "homepage": "https://aips.studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/alfredorr-ARTRs-pro/Quilly"
  },
  "bugs": {
    "url": "https://github.com/alfredorr-ARTRs-pro/Quilly/issues"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test electron/*.test.cjs src/**/*.test.cjs",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:9500 && electron .\"",
    "dist": "npm run build && electron-builder --win",
    "dist:store": "npm run build && electron-builder --win appx",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "adm-zip": "^0.5.16",
    "auto-launch": "^5.0.6",
    "check-disk-space": "^3.4.0",
    "electron-store": "^11.0.2",
    "onnxruntime-node": "^1.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "wavesurfer.js": "^7.12.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.quilly.app",
    "productName": "Quilly",
    "copyright": "Copyright © 2026 ARTRs pro AB (A.I.P.S.)",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "**/onnxruntime-node/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "executableName": "Quilly",
      "artifactName": "${productName}-V-${version}-Setup.${ext}"
    },
    "appx": {
      "applicationId": "Quilly",
      "identityName": "ARTRspro.QuillyVoicetoText",
      "publisher": "CN=63F43DB7-11B5-4738-9F40-D6C6BDB19B18",
      "publisherDisplayName": "ARTRs pro",
      "displayName": "Quilly Voice to Text",
      "backgroundColor": "transparent",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "languages": [
        "en-US"
      ],
      "capabilities": [
        "runFullTrust",
        "microphone"
      ],
      "artifactName": "${productName}-V-${version}-Store.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quilly",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "license": "LICENSE.txt"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "public/icon-mac.png",
      "identity": null,
      "darkModeSupport": true,
      "artifactName": "${productName}-V-${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Quilly needs microphone access to transcribe your speech.",
        "NSAppleEventsUsageDescription": "Quilly uses System Events to paste transcribed text into the app you're working in."
      }
    }
  }
}
